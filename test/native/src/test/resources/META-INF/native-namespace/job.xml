<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:elasticjob="http://shardingsphere.apache.org/schema/elasticjob"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://shardingsphere.apache.org/schema/elasticjob
                           http://shardingsphere.apache.org/schema/elasticjob/elasticjob.xsd
                           ">
    <elasticjob:memory id="regCenter" namespace="elasticjob-test-native-namespace-job" />
    
    <bean id="elasticJobTracingDataSource" class="com.zaxxer.hikari.HikariDataSource" destroy-method="close">
        <property name="driverClassName" value="org.h2.Driver" />
        <property name="jdbcUrl" value="jdbc:h2:mem:namespace_job_event_storage;DB_CLOSE_DELAY=-1" />
        <property name="username" value="sa" />
        <property name="password" value="" />
    </bean>
    <elasticjob:rdb-tracing id="elasticJobTrace" data-source-ref="elasticJobTracingDataSource" />
    
    <bean id="namespaceNativeOneOffJobImpl" class="org.apache.shardingsphere.elasticjob.test.natived.commons.job.namespace.NamespaceNativeSimpleJob" />
    <bean id="namespaceNativeScheduledJobImpl" class="org.apache.shardingsphere.elasticjob.test.natived.commons.job.namespace.NamespaceNativeSimpleJob" />
    
    <elasticjob:job id="namespaceNativeOneOffJob" job-ref="namespaceNativeOneOffJobImpl" registry-center-ref="regCenter"
             sharding-total-count="1" tracing-ref="elasticJobTrace" />
    <elasticjob:job id="namespaceNativeScheduledJob" job-ref="namespaceNativeScheduledJobImpl" registry-center-ref="regCenter"
             cron="0/1 * * * * ?" sharding-total-count="1" tracing-ref="elasticJobTrace" />
</beans>
